PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pharmacy_saas
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# In non-production the OTP code is returned by the API so demos work without an SMS gateway
OTP_DEMO_CODE=123456

# Public URL of the web app (payment provider return links)
PUBLIC_WEB_URL=http://localhost:3000

# Payments: set to use Paystack hosted checkout (card + mobile money). Unset = simulated "paid" for demos.
# PAYSTACK_SECRET_KEY=sk_test_...
# Webhook URL to register with Paystack: https://<api-host>/api/portal/webhooks/paystack

# SMS: log (default) | arkesel | webhook
SMS_PROVIDER=log
# ARKESEL_API_KEY=
# SMS_SENDER_ID=PharmaOne
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
