PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/pharmacy_saas
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Set NODE_ENV=production on the server (the Docker image does this already).
# NODE_ENV=production

# Demo deployment only. When true (or whenever NODE_ENV is not production) the customer sign-in code is fixed
# (OTP_DEMO_CODE) and shown on screen, and online payments are simulated if Paystack is not set up.
# Leave unset for a live pharmacy: codes then go by SMS only and online payment needs PAYSTACK_SECRET_KEY.
# DEMO_MODE=true
OTP_DEMO_CODE=123456

# `npm run seed` deletes ALL data. In production it only runs with SEED_CONFIRM=wipe-and-seed.

# Public URL of the web app (payment provider return links)
PUBLIC_WEB_URL=http://localhost:3000

# Payments: set to use Paystack hosted checkout (card + mobile money). Unset = simulated "paid" for demos.
# PAYSTACK_SECRET_KEY=sk_test_...
# Webhook URL to register with Paystack: https://<api-host>/api/portal/webhooks/paystack

# SMS: log (default) | arkesel | webhook
SMS_PROVIDER=log
# ARKESEL_API_KEY=
# SMS_SENDER_ID=PharmaOne
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
